DATABASE_URL="postgresql://verba:verba@localhost:5433/verba"
REDIS_URL="redis://localhost:6380"
TEST_DATABASE_URL="postgresql://verba:verba@localhost:5433/verba_test"

# Аудио на диске сервера (NFR-03)
AUDIO_DIR="data/audio"
# Провайдер STT: assemblyai или fake (без сети, ответ — pnpm stt:deliver)
STT_PROVIDER="fake"
# Очередь обработки: bullmq (нужен pnpm worker) или inline (сразу, без Redis)
VERBA_QUEUE="bullmq"

# AssemblyAI (ADR 0005). Регион по умолчанию — EU
ASSEMBLYAI_API_KEY=""
# ASSEMBLYAI_BASE_URL="https://api.eu.assemblyai.com"

# Уведомления провайдера: POST {PUBLIC_URL}/api/stt/webhook с секретом в
# заголовке X-Verba-Webhook-Secret. Без PUBLIC_URL (localhost) уведомлений
# нет — результат забирает проверка незавершённых записей.
PUBLIC_URL=""
STT_WEBHOOK_SECRET=""
# Проверка незавершённых записей, секунды: интервал (по умолчанию 300) и
# сколько ждать провайдера до «ошибки» (по умолчанию 10800 = 3 ч)
STT_SWEEP_INTERVAL="30"
# STT_TIMEOUT="10800"

{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:spec:*)",
      "Bash(pnpm test:e2e:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm db:up:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm exec prisma validate:*)",
      "Bash(pnpm exec prisma generate:*)",
      "Bash(pnpm exec prisma migrate diff:*)"
    ]
  }
}
